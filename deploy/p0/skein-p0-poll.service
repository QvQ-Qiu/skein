[Unit]
Description=Skein P0 shadow poll (read-only; requires LLM + forum read DB)
After=network-online.target skein-p0.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/skein-p0/services/control
EnvironmentFile=/etc/skein-p0/env
ExecStart=/root/skein-p0/services/control/.venv/bin/python -m skein.poll
Restart=always
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
