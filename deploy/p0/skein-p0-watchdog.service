[Unit]
Description=Skein Watchdog (signals + optional prompt canary)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/skein-p0/services/control
EnvironmentFile=/etc/skein-p0/env
ExecStart=/root/skein-p0/services/control/.venv/bin/python -m skein.watchdog_agent
Restart=always
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
